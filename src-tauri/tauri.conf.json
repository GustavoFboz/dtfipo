{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DentalFlow",
  "version": "0.6.3",
  "identifier": "br.com.dentalflow.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:desktop",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build:desktop",
    "frontendDist": "../dist/client"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DentalFlow",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "icon": ["icons/icon.ico"],
    "shortDescription": "Gestão odontológica integrada",
    "longDescription": "DentalFlow Desktop — gestão odontológica com operação local-first, sincronização automática, notificações e integrações nativas do Windows.",
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "DentalFlow",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-ui.nsh"
      }
    }
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DentalFlow",
  "version": "0.3.2",
  "identifier": "br.com.dentalflow.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:desktop",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build:desktop",
    "frontendDist": "../dist/client"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DentalFlow",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "shortDescription": "Hub empresarial para clínicas, laboratórios e radiologia odontológica",
    "longDescription": "DentalFlow Desktop — hub empresarial odontológico com sessões de Laboratório, Clínica e Radiologia, operação local-first, sincronização automática e integrações do Windows."
  }
}